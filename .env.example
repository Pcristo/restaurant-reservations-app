# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public production URL for reservation view and cancellation links
APP_URL="https://dinemaster.pages.dev"

# Cloudflare Pages / Edge Environment Variables:
# Resend API Key for Transactional Emails (Confirmation, Reminder, Cancellation, Update, Test)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nortada <reservas@nortada.pt>"

# Twilio SMS Credentials for Phone Number SMS Verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase / Firestore Client Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA v3 Site Key for Public Form Protection
VITE_RECAPTCHA_SITE_KEY=
